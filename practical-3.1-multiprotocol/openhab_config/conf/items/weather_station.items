Number WeatherTemperature "Temperature [%.1f °C]"
Number WeatherHumidity "Humidity [%.1f %%]"
Number WeatherPressure "Pressure [%.1f hPa]"
Number WeatherRssi "Signal Strength [%.0f dBm]"
String WeatherStatus "Connection Status [%s]"

WeatherTemperature { channel="mqtt:topic:weather_station:temperature" }
WeatherHumidity { channel="mqtt:topic:weather_station:humidity" }
WeatherPressure { channel="mqtt:topic:weather_station:pressure" }
WeatherRssi { channel="mqtt:topic:weather_station:rssi" }
WeatherStatus { channel="mqtt:topic:weather_station:status" }
